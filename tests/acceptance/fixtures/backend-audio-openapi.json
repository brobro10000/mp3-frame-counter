  "components": {
    "schemas": {
      "FrameCount": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frameCount"],
        "properties": {
          "frameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "error"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UPLOAD_EMPTY",
              "UPLOAD_INCOMPLETE",
              "REQUEST_INVALID",
              "MP3_INVALID_HEADER",
              "MP3_TRUNCATED_FRAME",
              "MP3_INVALID_METADATA",
              "MP3_NO_AUDIO_FRAMES",
              "ROUTE_NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "UPLOAD_TIMEOUT",
              "UPLOAD_IDLE_TIMEOUT",
              "UPLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "UNSUPPORTED_CONTENT_ENCODING",
              "MP3_UNSUPPORTED_FORMAT",
              "MP3_UNSUPPORTED_METADATA",
              "EXPECTATION_FAILED",
              "INTERNAL_ERROR",
              "SERVICE_BUSY",
              "UPSTREAM_UNAVAILABLE",
              "UPSTREAM_TIMEOUT"
            ]
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        }
      },
      "FrameDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frameCount", "analysis"],
        "properties": {
          "frameCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "analysis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["physicalFrameCount", "excludedMetadataFrameCount", "xing", "warnings"],
            "properties": {
              "physicalFrameCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "excludedMetadataFrameCount": {
                "type": "integer",
                "enum": [0, 1]
              },
              "xing": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["status"],
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": ["absent"]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "status",
                      "marker",
                      "frameOffsetBytes",
                      "frameLengthBytes",
                      "markerOffsetBytes",
                      "flags"
                    ],
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": ["present"]
                      },
                      "marker": {
                        "type": "string",
                        "enum": ["Xing", "Info"]
                      },
                      "frameOffsetBytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "frameLengthBytes": {
                        "type": "integer",
                        "minimum": 96,
                        "maximum": 9007199254740991
                      },
                      "markerOffsetBytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "flags": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 15
                      },
                      "declaredAudioFrameCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "declaredMpegStreamByteCount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "seekTableEntryCount": {
                        "type": "integer",
                        "enum": [100]
                      },
                      "qualityValue": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      }
                    }
                  }
                ]
              },
              "warnings": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["code"],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": ["XING_DECLARED_FRAME_COUNT_MISMATCH", "XING_DECLARED_STREAM_BYTES_MISMATCH"]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["code", "field"],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": ["XING_OPTIONAL_FIELD_TRUNCATED"]
                        },
                        "field": {
                          "type": "string",
                          "enum": [
                            "declaredAudioFrameCount",
                            "declaredMpegStreamByteCount",
                            "seekTable",
                            "qualityValue"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
