          }
        }
      }
    }
  },
  "x-transport-requirements": {
    "idleBodyMilliseconds": 10000,
    "totalBodyMilliseconds": 30000,
    "shutdownIntentMilliseconds": 5000,
    "description": "Expect 100-continue is sent only after route/header validation and slot admission. Busy uploads receive readable 503 plus Retry-After before any body; unsupported expectations receive 417. Deadlines receive readable 408 and release capacity. Allocation, retention, exact configuration and graceful drain require independent source/resource/operational review. OpenAPI cannot prove timing, byte enforcement, connection cleanup or memory bounds."
  }
