{
  "name": "mp3-frame-counter",
  "version": "0.0.0",
  "private": true,
  "description": "Repository foundation for a future TypeScript MP3 assessment",
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "lint:workflows": "node scripts/actionlint.mjs",
    "check:policy": "node scripts/policy.mjs",
    "check:portability": "node scripts/check-portability.mjs",
    "test:gate": "node --test scripts/ci-gate.test.mjs",
    "test:tooling": "node --test scripts/github-context.test.mjs scripts/portability.test.mjs scripts/phase-policy.test.mjs scripts/acceptance-baseline.test.mjs",
    "validate": "npm run format:check && npm run lint:workflows && npm run check:policy && npm run check:portability && npm run test:gate && npm run test:tooling",
    "verify:github": "node scripts/verify-github.mjs",
    "artifact:foundation": "node scripts/package-foundation.mjs",
    "check:phase": "node scripts/run-ci-phase.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "yaml": "2.9.1"
  }
}
